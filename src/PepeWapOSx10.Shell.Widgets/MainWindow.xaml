<Window x:Class="PepeWapOSx10.Shell.Widgets.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PepeWapOSx10.Shell.Widgets"
        mc:Ignorable="d"
        Title="Agenda Dinámica"
        Width="1364" Height="812"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBackground" Color="#61202430"/>
        <SolidColorBrush x:Key="PanelBorder" Color="#14E6E8EC"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#EDEFF2"/>
        <SolidColorBrush x:Key="TextMuted" Color="#8B93A1"/>
        <SolidColorBrush x:Key="TextFaint" Color="#6B7280"/>
        <SolidColorBrush x:Key="AccentFijo" Color="#E8A64D"/>
        <SolidColorBrush x:Key="AccentFlexible" Color="#55C2D6"/>
        <SolidColorBrush x:Key="AccentLibre" Color="#5B6472"/>
        <SolidColorBrush x:Key="BlockBackground" Color="#09EDEFF2"/>
        <SolidColorBrush x:Key="GridLine" Color="#0BE6E8EC"/>
        <SolidColorBrush x:Key="TabActiveBackground" Color="#2455C2D6"/>
        <SolidColorBrush x:Key="SelectedTint" Color="#0FEDEFF2"/>
        <SolidColorBrush x:Key="NavHoverBackground" Color="#0FEDEFF2"/>

        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="20"/>
        </Style>

        <Style x:Key="ViewTabButtonStyle" TargetType="ToggleButton">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" CornerRadius="7" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource TabActiveBackground}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavArrowButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="8" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource NavHoverBackground}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavTodayButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource AccentFlexible}"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="7" BorderThickness="1" BorderBrush="#59559ADE" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20" Background="Transparent" MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="225"/>
            <ColumnDefinition Width="22"/>
            <ColumnDefinition Width="793"/>
            <ColumnDefinition Width="22"/>
            <ColumnDefinition Width="262"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== PANEL CALENDARIO ===================== -->
        <Border Grid.Column="0" Style="{StaticResource PanelStyle}" Height="331" VerticalAlignment="Bottom" Padding="20,24">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <TextBlock x:Name="CalendarMonthText" FontFamily="Segoe UI Light" FontSize="19" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="CalendarYearText" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                    <Border BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                        <StackPanel>
                            <TextBlock x:Name="CalendarTodayText" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock x:Name="CalendarSummaryText" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <Grid x:Name="CalendarDaysGrid"/>
            </DockPanel>
        </Border>

        <!-- ===================== PANEL AGENDA ===================== -->
        <Border Grid.Column="2" Style="{StaticResource PanelStyle}" Padding="30,24">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                    <StackPanel HorizontalAlignment="Left">
                        <TextBlock Text="Agenda" FontFamily="Segoe UI Light" FontSize="22" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock x:Name="AgendaSubtitleText" FontSize="12.5" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource AccentFijo}" VerticalAlignment="Center"/>
                            <TextBlock Text="Fijo" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource AccentFlexible}" VerticalAlignment="Center"/>
                            <TextBlock Text="Flexible" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource AccentLibre}" VerticalAlignment="Center"/>
                            <TextBlock Text="Libre" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Background="#14000000" Margin="0,0,0,14"
                            HorizontalAlignment="Left">
                    <StackPanel.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </StackPanel.Resources>
                    <Border CornerRadius="10" Background="#14000000" Padding="3">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton x:Name="TabDia" Content="Día" Style="{StaticResource ViewTabButtonStyle}" Margin="2,0" IsChecked="True" Click="TabVista_Click" Tag="Dia"/>
                            <ToggleButton x:Name="TabSemana" Content="Semana" Style="{StaticResource ViewTabButtonStyle}" Margin="2,0" Click="TabVista_Click" Tag="Semana"/>
                            <ToggleButton x:Name="TabMes" Content="Mes" Style="{StaticResource ViewTabButtonStyle}" Margin="2,0" Click="TabVista_Click" Tag="Mes"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Grid x:Name="AgendaNavRow" DockPanel.Dock="Top" Margin="0,0,0,14" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="&#8249;" Style="{StaticResource NavArrowButtonStyle}" Click="NavPrev_Click"/>
                        <TextBlock x:Name="NavLabelText" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center" Margin="10,0" MinWidth="190"/>
                        <Button Content="&#8250;" Style="{StaticResource NavArrowButtonStyle}" Click="NavNext_Click"/>
                        <Button Content="HOY" Style="{StaticResource NavTodayButtonStyle}" Click="NavHoy_Click" Margin="14,0,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="NavHintText" FontSize="10.5" FontStyle="Italic" Foreground="{StaticResource TextFaint}"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <Grid>
                    <!-- Vista Día -->
                    <ScrollViewer x:Name="DiaScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Height="660"
                                  PreviewMouseWheel="DiaScroll_PreviewMouseWheel" ScrollChanged="DiaScroll_ScrollChanged">
                        <Canvas x:Name="AgendaCanvas" Width="733"/>
                    </ScrollViewer>

                    <!-- Vista Semana -->
                    <DockPanel x:Name="SemanaPanel" Visibility="Collapsed">
                        <Grid x:Name="SemanaHeadGrid" DockPanel.Dock="Top" Margin="0,0,0,8"/>
                        <ScrollViewer x:Name="SemanaScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Height="612">
                            <Canvas x:Name="SemanaCanvas" Width="733"/>
                        </ScrollViewer>
                    </DockPanel>

                    <!-- Vista Mes -->
                    <DockPanel x:Name="MesPanel" Visibility="Collapsed">
                        <Grid x:Name="MesHeadGrid" DockPanel.Dock="Top" Margin="0,0,0,8"/>
                        <Grid x:Name="MesRowsGrid" Height="620"/>
                    </DockPanel>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ===================== PANEL GUIA (TareaGuia) ===================== -->
        <Border Grid.Column="4" Style="{StaticResource PanelStyle}" MaxHeight="772" VerticalAlignment="Top" Padding="20,24">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,18">
                    <StackPanel HorizontalAlignment="Left">
                        <TextBlock Text="Guía" FontFamily="Segoe UI Light" FontSize="19" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock x:Name="GuiaSummaryText" FontSize="11.5" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Content="+" Style="{StaticResource NavArrowButtonStyle}" FontSize="18"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            ToolTip="Agregar tarea a la guía" Click="GuiaAgregar_Click"/>
                </Grid>
                <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="GuiaPanel"/>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
