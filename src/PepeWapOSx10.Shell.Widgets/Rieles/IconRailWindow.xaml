<Window x:Class="PepeWapOSx10.Shell.Widgets.IconRailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Riel de iconos"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        SizeToContent="Manual">

    <!-- Los colores salen de Tema.xaml (App.Resources); acá solo vive el
         estilo del casillero, que no lo usa ninguna otra ventana. -->
    <Window.Resources>
        <!-- Una sola instancia compartida por todos los casilleros: el ícono
             sobre el que se abrió sale del PlacementTarget, así que no hace
             falta un menú por ítem. -->
        <ContextMenu x:Key="MenuDeIcono" Style="{StaticResource MenuContextualStyle}">
            <MenuItem Header="Ejecutar" Style="{StaticResource MenuContextualItemStyle}"
                      Click="MenuEjecutar_Click"/>
            <MenuItem Header="Abrir ubicación del acceso directo" Style="{StaticResource MenuContextualItemStyle}"
                      Click="MenuAbrirUbicacion_Click"/>
            <Separator Style="{StaticResource MenuContextualSeparadorStyle}"/>
            <MenuItem Header="Quitar del riel" Style="{StaticResource MenuContextualItemStyle}"
                      Click="MenuQuitar_Click"/>
        </ContextMenu>

        <Style x:Key="IconSlotStyle" TargetType="ListBoxItem">
            <Setter Property="ContextMenu" Value="{StaticResource MenuDeIcono}"/>
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="Margin" Value="0,7"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Slot" CornerRadius="14"
                                Background="{StaticResource SlotIdle}"
                                BorderThickness="1" BorderBrush="Transparent"
                                ToolTip="{Binding Label}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Slot" Property="Background" Value="{StaticResource SlotHoverBackground}"/>
                                <Setter TargetName="Slot" Property="BorderBrush" Value="{StaticResource SlotHoverBorder}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Slot" Property="Background" Value="{StaticResource SlotSelectedBackground}"/>
                                <Setter TargetName="Slot" Property="BorderBrush" Value="{StaticResource SlotSelectedBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.10" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.10" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.0" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.0" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource RailBackground}" BorderBrush="{StaticResource RailBorder}"
            BorderThickness="1" CornerRadius="18" Padding="0,14" ClipToBounds="True">
        <ListBox x:Name="IconosControl"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.VerticalScrollBarVisibility="Hidden" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionMode="Single"
                 ItemContainerStyle="{StaticResource IconSlotStyle}"
                 AllowDrop="True"
                 PreviewMouseLeftButtonDown="Iconos_PreviewMouseLeftButtonDown"
                 PreviewMouseMove="Iconos_PreviewMouseMove"
                 MouseLeftButtonUp="Iconos_MouseLeftButtonUp"
                 DragOver="Iconos_DragOver"
                 Drop="Iconos_Drop">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Image Source="{Binding Icono}" Width="32" Height="32"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Border>
</Window>
