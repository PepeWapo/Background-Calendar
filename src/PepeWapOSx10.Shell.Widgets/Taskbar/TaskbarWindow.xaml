<Window x:Class="PepeWapOSx10.Shell.Widgets.TaskbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Taskbar"
        Background="{x:Null}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        SizeToContent="Manual">

    <!-- Fondo nulo y no "Transparent": un pincel transparente igual recibe los
         clicks en WPF, y acá todo lo que no sea un ícono tiene que dejarlos
         pasar al escritorio. Sin panel de por medio (a diferencia del resto
         del shell): acá el pedido es íconos flotando directo sobre el
         escritorio, sin card. Cada ícono solo tiene su propio resalte de
         hover (SlotIdle ya es casi invisible en reposo). -->

    <Window.Resources>
        <Style x:Key="TaskbarIconButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="10" Padding="{TemplateBinding Padding}"
                                Background="{StaticResource SlotIdle}"
                                BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource SlotHoverBackground}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource SlotHoverBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

        <!-- Fila superior: menú de Windows, Explorador, y donde va a colgar la
             lista de apps en ejecución/ancladas (pendiente, ver Pendiente en
             el .xaml.cs). -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
            <Button x:Name="BotonMenuWindows" Style="{StaticResource TaskbarIconButtonStyle}" Margin="2,0" ToolTip="Menú de Windows"
                    Click="BotonMenuWindows_Click">
                <Viewbox Width="18" Height="18">
                    <Canvas Width="24" Height="24">
                        <Rectangle Canvas.Left="3" Canvas.Top="3" Width="8" Height="8" Fill="{StaticResource TextPrimary}"/>
                        <Rectangle Canvas.Left="13" Canvas.Top="3" Width="8" Height="8" Fill="{StaticResource TextPrimary}"/>
                        <Rectangle Canvas.Left="3" Canvas.Top="13" Width="8" Height="8" Fill="{StaticResource TextPrimary}"/>
                        <Rectangle Canvas.Left="13" Canvas.Top="13" Width="8" Height="8" Fill="{StaticResource TextPrimary}"/>
                    </Canvas>
                </Viewbox>
            </Button>

            <Button x:Name="BotonExplorador" Style="{StaticResource TaskbarIconButtonStyle}" Margin="2,0" ToolTip="Explorador de archivos"
                    Click="BotonExplorador_Click">
                <Viewbox Width="20" Height="20">
                    <Canvas Width="24" Height="24">
                        <Path Data="M3 6.5a1.5 1.5 0 0 1 1.5-1.5H9l2 2.5h8.5A1.5 1.5 0 0 1 21 9v8.5A1.5 1.5 0 0 1 19.5 19h-15A1.5 1.5 0 0 1 3 17.5z"
                              Stroke="{StaticResource TextPrimary}" StrokeThickness="1.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Canvas>
                </Viewbox>
            </Button>

            <Rectangle Width="1" Height="20" Margin="8,0" Fill="{StaticResource MenuSeparator}"/>

            <!-- Pendiente (próxima fase): acá van los íconos de programas en
                 ejecución y anclados, enumerados en vivo (EnumWindows) con la
                 posibilidad de anclar/desanclar. Por ahora queda vacío. -->
            <StackPanel x:Name="AppsEnEjecucion" Orientation="Horizontal"/>
        </StackPanel>

        <!-- Fila inferior: bandeja de Windows (real, vía flyout nativo) y
             apagado — todo más chico y apagado que la fila principal. -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="BotonBandeja" Style="{StaticResource TaskbarIconButtonStyle}" Margin="2,0" ToolTip="Bandeja del sistema"
                    Click="BotonBandeja_Click">
                <Viewbox Width="16" Height="16">
                    <Canvas Width="24" Height="24">
                        <Path Data="M6 15l6-6 6 6"
                              Stroke="{StaticResource TextMuted}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Canvas>
                </Viewbox>
            </Button>

            <Rectangle Width="1" Height="18" Margin="8,0" Fill="{StaticResource MenuSeparator}"/>

            <Button Style="{StaticResource TaskbarIconButtonStyle}" Margin="2,0" ToolTip="Suspender">
                <Viewbox Width="17" Height="17">
                    <Canvas Width="24" Height="24">
                        <Path Data="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5z"
                              Stroke="{StaticResource TextMuted}" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Canvas>
                </Viewbox>
            </Button>

            <Button Style="{StaticResource TaskbarIconButtonStyle}" Margin="2,0" ToolTip="Reiniciar">
                <Viewbox Width="17" Height="17">
                    <Canvas Width="24" Height="24">
                        <Path Data="M4 12a8 8 0 1 1 2.6 5.9"
                              Stroke="{StaticResource TextMuted}" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        <Path Data="M4 17.5V13h4.5"
                              Stroke="{StaticResource TextMuted}" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Canvas>
                </Viewbox>
            </Button>

            <Button Style="{StaticResource TaskbarIconButtonStyle}" Margin="2,0" ToolTip="Apagar">
                <Viewbox Width="17" Height="17">
                    <Canvas Width="24" Height="24">
                        <Path Data="M12 3.5v8"
                              Stroke="{StaticResource TextMuted}" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        <Path Data="M7 6.2a8 8 0 1 0 10 0"
                              Stroke="{StaticResource TextMuted}" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Canvas>
                </Viewbox>
            </Button>
        </StackPanel>
    </StackPanel>
</Window>
