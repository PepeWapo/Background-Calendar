<Window x:Class="PepeWapOSx10.Shell.Widgets.EditarTareaGuiaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tarea de la guía"
        Width="340" SizeToContent="Height"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <SolidColorBrush x:Key="DlgBackground" Color="#F21B1F2A"/>
        <SolidColorBrush x:Key="DlgBorder" Color="#26E6E8EC"/>
        <SolidColorBrush x:Key="DlgText" Color="#EDEFF2"/>
        <SolidColorBrush x:Key="DlgMuted" Color="#8B93A1"/>
        <SolidColorBrush x:Key="DlgAccent" Color="#55C2D6"/>

        <Style TargetType="TextBlock" x:Key="Etiqueta">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource DlgMuted}"/>
            <Setter Property="Margin" Value="0,14,0,5"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource DlgText}"/>
            <Setter Property="Background" Value="#14000000"/>
            <Setter Property="BorderBrush" Value="{StaticResource DlgBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CaretBrush" Value="{StaticResource DlgText}"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource DlgBackground}" BorderBrush="{StaticResource DlgBorder}"
            BorderThickness="1" CornerRadius="16" Padding="22,18,22,18"
            MouseLeftButtonDown="Raiz_MouseLeftButtonDown">
        <StackPanel>
            <TextBlock x:Name="TituloDialogo" FontFamily="Segoe UI Light" FontSize="18"
                       Foreground="{StaticResource DlgText}"/>

            <TextBlock Text="TÍTULO" Style="{StaticResource Etiqueta}"/>
            <TextBox x:Name="TituloBox" MaxLength="80"/>

            <TextBlock Text="CATEGORÍA" Style="{StaticResource Etiqueta}"/>
            <ComboBox x:Name="CategoriaBox" IsEditable="True"/>

            <TextBlock Text="REPETICIÓN" Style="{StaticResource Etiqueta}"/>
            <ComboBox x:Name="RepeticionBox"/>

            <TextBlock x:Name="ErrorText" FontSize="11" Foreground="#E8845D" Margin="0,10,0,0"
                       TextWrapping="Wrap" Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Cancelar" Click="Cancelar_Click" IsCancel="True"
                        Padding="14,6" Margin="0,0,8,0" Cursor="Hand"/>
                <Button Content="Guardar" Click="Guardar_Click" IsDefault="True"
                        Padding="18,6" Cursor="Hand" Foreground="Black"
                        Background="{StaticResource DlgAccent}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
