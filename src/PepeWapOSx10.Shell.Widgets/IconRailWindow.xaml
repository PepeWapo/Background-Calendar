<Window x:Class="PepeWapOSx10.Shell.Widgets.IconRailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Riel de iconos"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        SizeToContent="Manual">

    <Window.Resources>
        <SolidColorBrush x:Key="RailBackground" Color="#891B1F2A"/>
        <SolidColorBrush x:Key="RailBorder" Color="#26E6E8EC"/>
        <SolidColorBrush x:Key="RailText" Color="#8B93A1"/>
        <SolidColorBrush x:Key="SlotIdle" Color="#0AFFFFFF"/>
        <SolidColorBrush x:Key="SlotHoverBackground" Color="#5955C2D6"/>
        <SolidColorBrush x:Key="SlotHoverBorder" Color="#8C55C2D6"/>
        <SolidColorBrush x:Key="SlotSelectedBackground" Color="#8055C2D6"/>
        <SolidColorBrush x:Key="SlotSelectedBorder" Color="#E655C2D6"/>

        <Style x:Key="IconSlotStyle" TargetType="ListBoxItem">
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="Margin" Value="0,7"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Slot" CornerRadius="14"
                                Background="{StaticResource SlotIdle}"
                                BorderThickness="1" BorderBrush="Transparent"
                                ToolTip="{Binding Label}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Slot" Property="Background" Value="{StaticResource SlotHoverBackground}"/>
                                <Setter TargetName="Slot" Property="BorderBrush" Value="{StaticResource SlotHoverBorder}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Slot" Property="Background" Value="{StaticResource SlotSelectedBackground}"/>
                                <Setter TargetName="Slot" Property="BorderBrush" Value="{StaticResource SlotSelectedBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.10" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.10" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.0" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.0" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource RailBackground}" BorderBrush="{StaticResource RailBorder}"
            BorderThickness="1" CornerRadius="18" Padding="0,14" ClipToBounds="True">
        <ListBox x:Name="IconosControl"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.VerticalScrollBarVisibility="Hidden" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionMode="Single"
                 ItemContainerStyle="{StaticResource IconSlotStyle}"
                 AllowDrop="True"
                 MouseDoubleClick="IconosControl_MouseDoubleClick"
                 PreviewMouseLeftButtonDown="IconosControl_PreviewMouseLeftButtonDown"
                 PreviewMouseMove="IconosControl_PreviewMouseMove"
                 DragOver="IconosControl_DragOver"
                 Drop="IconosControl_Drop">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Image Source="{Binding Icono}" Width="32" Height="32"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Border>
</Window>
