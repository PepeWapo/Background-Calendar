<Window x:Class="PepeWapOSx10.Shell.Widgets.IconRailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Riel de iconos"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        SizeToContent="Manual">

    <Window.Resources>
        <SolidColorBrush x:Key="RailBackground" Color="#C81B1F2A"/>
        <SolidColorBrush x:Key="RailBorder" Color="#26E6E8EC"/>
        <SolidColorBrush x:Key="RailText" Color="#8B93A1"/>
        <SolidColorBrush x:Key="SlotIdle" Color="#0AFFFFFF"/>
        <SolidColorBrush x:Key="SlotHoverBackground" Color="#5955C2D6"/>
        <SolidColorBrush x:Key="SlotHoverBorder" Color="#8C55C2D6"/>

        <Style x:Key="IconSlotStyle" TargetType="Border">
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="Margin" Value="0,7"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Background" Value="{StaticResource SlotIdle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.10" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.10" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.0" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.0" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                    <Setter Property="Background" Value="{StaticResource SlotHoverBackground}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource SlotHoverBorder}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource RailBackground}" BorderBrush="{StaticResource RailBorder}"
            BorderThickness="1" CornerRadius="18" Padding="0,14">
        <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="IconosControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource IconSlotStyle}" ToolTip="{Binding Label}">
                            <TextBlock Text="{Binding Glyph}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Border>
</Window>
