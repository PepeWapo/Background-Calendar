<Window x:Class="PepeWapOSx10.Shell.Widgets.VideoWallpaperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="Wallpaper"
        Background="Black"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">

    <!-- El velo va DENTRO del VideoView a propósito: es contenido WPF, y
         LibVLCSharp.WPF lo dibuja en su ventana interna, que se compone por
         encima del video nativo. Puesto como hermano en un Grid quedaría
         debajo y no taparía nada (ver el comentario de RotarAsync). -->
    <vlc:VideoView x:Name="Reproductor">
        <Rectangle x:Name="Velo" Fill="Black" Opacity="0" IsHitTestVisible="False"/>
    </vlc:VideoView>
</Window>
